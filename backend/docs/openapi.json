{
  "openapi": "3.0.3",
  "info": {
    "title": "AeroScope India Flask Research API",
    "version": "1.0.0",
    "description": "Historical INSAT-3D AOD clustering research. Not current AQI, ground-level PM2.5, health exposure, or a forecast. Research-result endpoints are disabled on public production hosts until derived-output release rights are reviewed."
  },
  "servers": [
    {
      "url": "/",
      "description": "Origin of the Flask API"
    }
  ],
  "tags": [
    {
      "name": "Service / documentation",
      "description": "Operational metadata with no per-grid research values"
    },
    {
      "name": "Research results",
      "description": "Locally available results, protected by production release policy"
    }
  ],
  "paths": {

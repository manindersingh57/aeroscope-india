AEROSCOPE_ENV=development
AEROSCOPE_ALLOWED_ORIGINS=http://localhost:5173
AEROSCOPE_ENABLE_GRID_API=false
# For PUBLIC production hosting, keep false until MOSDAC-derived output release is confirmed.
AEROSCOPE_PUBLIC_RESULTS_ENABLED=false
# Set only if the data/config folders are not inside backend/
# AEROSCOPE_PACKAGE_DIR=/absolute/path/to/aeroscope_backend
